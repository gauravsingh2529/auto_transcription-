{
  "name": "realtime-transcription",
  "version": "1.0.0",
  "description": "Real-time multilingual (Hindi + English) speech-to-text with Gemini Live, PostgreSQL history and a CRUD dashboard",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "keywords": ["speech-to-text", "gemini-live", "websocket", "postgresql", "hinglish"],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^3.6.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
