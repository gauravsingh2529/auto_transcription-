# ---- Server ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL ----
# The database is created automatically on first start if the user has CREATEDB rights.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/transcription_db

# ---- Gemini Live (speech-to-text) ----
# Free key: https://aistudio.google.com/apikey
# Leave empty to use only the in-browser Web Speech engine.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Native-audio Live models require AUDIO; half-cascade models also accept TEXT.
GEMINI_RESPONSE_MODALITY=AUDIO
# Comma-separated BCP-47 hints. Code-mixed Hinglish works best with both.
GEMINI_LANGUAGE_CODES=hi-IN,en-IN
